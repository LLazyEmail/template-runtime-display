{
  "name": "@llazyemail/template-runtime-display",
  "version": "1.0.0",
  "description": "Standalone runtime that renders a whole HTML email from named parts, shows which part broke, and ships a live inspector.",
  "type": "module",
  "license": "MIT",
  "author": "LLazyEmail",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "template-runtime-display": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./escape": {
      "import": {
        "types": "./dist/escape.d.ts",
        "default": "./dist/escape.js"
      },
      "require": {
        "types": "./dist/escape.d.cts",
        "default": "./dist/escape.cjs"
      }
    },
    "./head": {
      "import": {
        "types": "./dist/head.d.ts",
        "default": "./dist/head.js"
      },
      "require": {
        "types": "./dist/head.d.cts",
        "default": "./dist/head.cjs"
      }
    },
    "./body": {
      "import": {
        "types": "./dist/body.d.ts",
        "default": "./dist/body.js"
      },
      "require": {
        "types": "./dist/body.d.cts",
        "default": "./dist/body.cjs"
      }
    },
    "./main": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    },
    "./document": {
      "import": {
        "types": "./dist/document.d.ts",
        "default": "./dist/document.js"
      },
      "require": {
        "types": "./dist/document.d.cts",
        "default": "./dist/document.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "npm run build && node scripts/generate.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run smoke && npm run publint",
    "prepublishOnly": "npm run check",
    "demo": "npm run build && node dist/cli.js dev examples/inspect-demo.mjs",
    "inspect": "node dist/cli.js inspect"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "markup-generator": "^3.2.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.15",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/template-runtime-display.git"
  },
  "bugs": {
    "url": "https://github.com/LLazyEmail/template-runtime-display/issues"
  },
  "homepage": "https://github.com/LLazyEmail/template-runtime-display#readme",
  "keywords": [
    "email",
    "html",
    "template",
    "newsletter",
    "runtime",
    "debug",
    "llazyemail",
    "esm",
    "escape",
    "inspector",
    "dev-server",
    "live-reload"
  ],
  "dependencies": {
    "@llazyemail/render-template": "github:LLazyEmail/render-template#0.3.0"
  }
}
